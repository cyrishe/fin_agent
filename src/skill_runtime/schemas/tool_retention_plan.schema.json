{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool_retention_plan.schema.json",
  "title": "Tool Retention Plan",
  "type": "object",
  "required": ["tool_name", "rules"],
  "properties": {
    "tool_name": { "type": "string" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["path", "action", "target", "reason"],
      "properties": {
        "path": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["reasoning", "compress", "pass_through", "drop"]
        },
        "target": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["prompt", "render", "storage"]
          }
        },
        "method": {
          "type": "string",
          "enum": [
            "extract_metrics",
            "summarize_table",
            "summarize_timeseries",
            "summarize_news_list",
            "summarize_report_list",
            "extract_key_points"
          ]
        },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}

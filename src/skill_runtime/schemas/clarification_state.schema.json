{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clarification_state.schema.json",
  "title": "ClarificationState",
  "type": "object",
  "required": [
    "state_type",
    "status",
    "missing_slots",
    "prompt"
  ],
  "properties": {
    "state_type": {
      "type": "string",
      "const": "clarification_state"
    },
    "status": {
      "type": "string",
      "enum": ["needs_user_input", "ready", "rejected"]
    },
    "missing_slots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prompt": {
      "type": "string"
    },
    "resume_token": {
      "type": "string"
    },
    "slot_hints": {
      "type": "object"
    },
    "context_summary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

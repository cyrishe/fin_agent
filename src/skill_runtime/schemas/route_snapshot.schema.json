{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route_snapshot.schema.json",
  "title": "RouteSnapshot",
  "type": "object",
  "required": [
    "snapshot_type",
    "source",
    "route"
  ],
  "properties": {
    "snapshot_type": {
      "type": "string",
      "const": "route_snapshot"
    },
    "source": {
      "type": "string",
      "enum": ["explicit_skill", "natural_language_preview", "task_submit"]
    },
    "router_version": {
      "type": "string"
    },
    "user_text": {
      "type": "string"
    },
    "context_summary": {
      "type": "object"
    },
    "route": {
      "$ref": "intent_route.schema.json"
    },
    "composite_execution_plan": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": false
}

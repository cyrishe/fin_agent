  "quick_actions": [
    {
      "title": "公司数据",
      "description": "查询上市公司的财务指标和经营趋势。",
      "prompt": "海尔智家近四年的营业收入和归母净利润走势如何？"
    },
    {
      "title": "研报预测",
      "description": "汇总机构观点和未来盈利预测。",
      "prompt": "汇总主要机构对中际旭创未来两年的盈利预测。"
    },
    {
      "title": "横向比较",
      "description": "比较多家公司的核心指标和估值。",
      "prompt": "比较贵州茅台和五粮液最近一期的盈利能力与估值。"
    },
    {
      "title": "市场筛选",
      "description": "按行情、资金流等条件发现候选公司。",
      "prompt": "找出近20个交易日涨幅居前且主力资金净流入的A股公司。"
    }
  ],
  "chat_placeholder": "输入金融问题，例如公司财务、行情、估值、资金流或研报数据",
  "assistant_intro": "你好，我是 Fin Agent。你可以直接询问上市公司、行情、财务、估值、资金流和研报数据，我会先取得真实数据，再给出可核查的结论。"

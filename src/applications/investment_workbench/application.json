  "quick_commands": [
    "/applications",
    "/agents",
    "/skills",
    "/tools",
    "/tasks"
  ],
  "quick_actions": [
    {
      "title": "新建 Skill",
      "description": "通过模板先生成 skill 骨架，再进入 Skill Studio 调整。",
      "prompt": "/new-skill my_new_skill"
    },
    {
      "title": "需求生成 Skill 草稿",
      "description": "先根据自然语言生成 skill 骨架，再进入 Skill Studio 精修。",
      "prompt": "/draft-skill momentum_review_draft 根据动量榜和资金流，输出一份简洁的市场复盘。"
    },
    {
      "title": "优化已有 Skill",
      "description": "基于已有 skill 生成一份优化 draft，再进入 Skill Studio 调整。",
      "prompt": "/refine-skill stock_deep_dive 加强对资金流和风险部分的分析，输出更简洁。"
    },
    {
      "title": "自由对话",
      "description": "自然语言先走 route，再决定是否进入 skill 或 task。",
      "prompt": "请分析今天的动量榜，并告诉我下一步应该看哪个 skill 或 tool。"
    }
  ],
  "chat_placeholder": "输入自由问题，或使用 /applications /agents /skills /tools /tasks /new-skill xxx",
  "assistant_intro": "可以先试：/applications、/agents、/skills、/tools、/tasks、/new-skill my_new_skill、/draft-skill xxx 需求描述，或者直接输入自然语言问题。"
}

    "new_agent": {
      "type": "agent_editor",
      "title": "Agent Editor",
      "url": "/agents/studio/{agent_name}"
    },
    "agent_detail": {
      "type": "agent_editor",
      "title": "Agent Editor",
      "url": "/agents/studio/{agent_name}"
    },
    "skill_detail": {
      "type": "skill_editor",
      "title": "Skill Editor",
      "url": "/skills/studio/{skill_name}"
    },
    "tool_detail": {
      "type": "tool_editor",

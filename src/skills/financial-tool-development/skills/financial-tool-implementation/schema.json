{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message",
    "tool_contract",
    "implementation_summary",
    "verification",
    "sample_input_json"
  ],
  "properties": {
    "message": {
      "type": "string"
    },
    "tool_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "display_name",
        "description",
        "inputs",
        "outputs"
      ],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "array",
                  "object"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "implementation_summary": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "sample_input_json": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["requirement_brief"],
  "properties": {
    "requirement_brief": {"type": "string", "minLength": 1},
    "notice": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["question", "candidate"],
        "properties": {
          "question": {"type": "string"},
          "candidate": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}

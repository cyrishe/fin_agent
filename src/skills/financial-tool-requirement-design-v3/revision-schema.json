{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "change_summary", "questions", "changes"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["clarification", "review"]
    },
    "change_summary": {"type": "string"},
    "questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    },
    "changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/change"}
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "description", "recommended"],
      "properties": {
        "value": {"type": "string"},
        "label": {"type": "string"},
        "description": {"type": "string"},
        "recommended": {"type": "boolean"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "reason", "answer_type", "required", "options", "allow_custom"],
      "properties": {
        "id": {"type": "string"},
        "question": {"type": "string"},
        "reason": {"type": "string"},
        "answer_type": {
          "type": "string",
          "enum": ["single_choice", "multiple_choice", "number", "text", "boolean"]
        },
        "required": {"type": "boolean"},
        "options": {
          "type": "array",
          "items": {"$ref": "#/$defs/option"}
        },
        "allow_custom": {"type": "boolean"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value_json"],
      "properties": {
        "path": {
          "type": "string",
          "enum": [
            "understanding.goal",
            "understanding.usage",
            "understanding.expected_result",
            "understanding.confirmed_requirements",
            "understanding.constraints",
            "understanding.assumptions",
            "design.tool_name",
            "design.display_name",
            "design.description",
            "design.inputs",
            "design.outputs",
            "design.modules",
            "design.flow",
            "design.rules",
            "design.data_requirements",
            "design.exceptions",
            "design.acceptance",
            "existing_analysis"
          ]
        },
        "value_json": {"type": "string"}
      }
    }
  }
}

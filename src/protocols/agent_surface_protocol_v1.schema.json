{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin-agent.local/schemas/agent_surface_protocol_v1.schema.json",
  "title": "Agent Surface Protocol v1",
  "description": "Canonical business surface, streaming event, interaction response, and model draft contracts for fin_agent.",
  "oneOf": [
    { "$ref": "#/$defs/EventEnvelope" },
    { "$ref": "#/$defs/InteractionResponse" },
    { "$ref": "#/$defs/ModelSurfaceDraft" },
    { "$ref": "#/$defs/ClientCapabilities" }
  ],
  "$defs": {
    "ProtocolVersion": {
      "const": "agent_surface.v1"
    },
    "WorkStatus": {
      "enum": [
        "pending",
        "running",
        "waiting_user",
        "succeeded",
        "partial",
        "skipped",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "WaitReason": {
      "enum": ["input", "approval", "authentication", "external", "rate_limit"]
    },
    "BlockKind": {
      "enum": [
        "narrative",
        "data",
        "workflow",
        "artifact",
        "assessment",
        "resource",
        "interaction"
      ]
    },
    "SectionRole": {
      "enum": ["primary", "process", "evidence", "artifact", "interaction", "diagnostic"]
    },
    "EntityTarget": {
      "type": "object",
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 },
        "block_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "SectionTarget": {
      "type": "object",
      "required": ["surface_id", "section_id"],
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "BlockTarget": {
      "type": "object",
      "required": ["surface_id", "section_id", "block_id"],
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "section_id": { "type": "string", "minLength": 1 },
        "block_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "TraceContext": {
      "type": "object",
      "properties": {
        "trace_id": { "type": "string" },
        "span_id": { "type": "string" },
        "parent_span_id": { "type": "string" },
        "provider_event_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "RunStatePayload": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/WorkStatus" },
        "stage": { "type": "string" },
        "summary": { "type": "string" },
        "wait_reason": { "$ref": "#/$defs/WaitReason" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "outcome": {
          "enum": ["succeeded", "partial", "blocked", "failed", "cancelled"]
        },
        "reason_code": { "type": "string" },
        "retryable": { "type": "boolean" },
        "usage": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "waiting_user" } } },
          "then": { "required": ["wait_reason"] }
        }
      ],
      "additionalProperties": true
    },
    "PresentationHint": {
      "type": "object",
      "properties": {
        "preferred_renderer": { "type": "string" },
        "fallback_renderer": { "type": "string" },
        "density": { "enum": ["compact", "comfortable", "detailed"] },
        "emphasis": { "enum": ["normal", "high", "critical"] },
        "default_state": { "enum": ["expanded", "collapsed", "hidden"] }
      },
      "additionalProperties": false
    },
    "InstrumentRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "asset_type": { "type": "string" },
        "market": { "type": "string" }
      },
      "additionalProperties": true
    },
    "FinanceContext": {
      "type": "object",
      "required": ["namespace"],
      "properties": {
        "namespace": { "const": "finance" },
        "as_of": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string" },
        "markets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "instruments": { "type": "array", "items": { "$ref": "#/$defs/InstrumentRef" } },
        "currency": { "type": "string" },
        "unit": { "type": "string" },
        "frequency": { "type": "string" },
        "adjustment": {
          "enum": ["none", "forward", "backward", "split_dividend", "custom"]
        },
        "data_mode": {
          "enum": ["real_time", "delayed", "end_of_day", "historical", "estimated", "simulated"]
        },
        "calendar": { "type": "string" },
        "universe": { "type": "string" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "Provenance": {
      "type": "object",
      "required": ["produced_by"],
      "properties": {
        "produced_by": { "enum": ["user", "agent", "tool", "system", "adapter"] },
        "producer_id": { "type": "string" },
        "tool_call_id": { "type": "string" },
        "source_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "generated_at": { "type": "string", "format": "date-time" },
        "as_of": { "type": "string", "format": "date-time" },
        "transform": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "trace_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "BlockBase": {
      "type": "object",
      "required": ["block_id", "kind", "status", "payload"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/BlockKind" },
        "status": { "$ref": "#/$defs/WorkStatus" },
        "revision": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "semantic": { "type": "string" },
        "stage": { "type": "string" },
        "visibility": { "enum": ["primary", "details", "diagnostic", "hidden"] },
        "persistence": { "enum": ["durable", "ephemeral"] },
        "payload": {},
        "presentation_hint": { "$ref": "#/$defs/PresentationHint" },
        "domain_context": { "$ref": "#/$defs/FinanceContext" },
        "provenance": { "type": "array", "items": { "$ref": "#/$defs/Provenance" } },
        "annotations": { "type": "object", "additionalProperties": true }
      }
    },
    "NarrativePayload": {
      "type": "object",
      "required": ["format", "text"],
      "properties": {
        "format": { "enum": ["plain", "markdown"] },
        "text": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "DataQuality": {
      "type": "object",
      "properties": {
        "status": { "enum": ["good", "degraded", "unknown"] },
        "freshness": { "type": "string" },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "issues": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "DataPayload": {
      "type": "object",
      "required": ["shape", "content_type", "data"],
      "properties": {
        "shape": {
          "enum": ["scalar", "record", "records", "series", "timeseries", "graph", "hierarchy"]
        },
        "content_type": { "type": "string", "minLength": 1 },
        "content_schema_version": { "type": "string" },
        "schema": { "type": "object", "additionalProperties": true },
        "data": {},
        "quality": { "$ref": "#/$defs/DataQuality" },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "WorkItem": {
      "type": "object",
      "required": ["item_id", "label", "status"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/WorkStatus" },
        "parent_id": { "type": "string" },
        "detail": { "type": "string" },
        "progress": { "type": "number", "minimum": 0, "maximum": 1 },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "attempt": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "result_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "WorkflowPayload": {
      "type": "object",
      "required": ["scope", "items"],
      "properties": {
        "scope": { "enum": ["plan", "task", "step", "tool_call", "loop", "validation"] },
        "summary": { "type": "string" },
        "current_item_id": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/WorkItem" } }
      },
      "additionalProperties": true
    },
    "ArtifactPayload": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "lifecycle", "version", "content_type"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["draft", "reviewable", "approved", "published", "superseded"] },
        "version": { "type": "string", "minLength": 1 },
        "content_type": { "type": "string", "minLength": 1 },
        "content_schema_version": { "type": "string" },
        "content": {},
        "resource_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "base_version": { "type": "string" },
        "change_summary": { "type": "string" },
        "validation_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "anyOf": [
        { "required": ["content"] },
        { "required": ["resource_refs"] }
      ],
      "additionalProperties": true
    },
    "AssessmentDimension": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "status": { "enum": ["pass", "warn", "fail", "unknown"] },
        "detail": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "AssessmentIssue": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["info", "warning", "error", "critical"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "AssessmentPayload": {
      "type": "object",
      "required": ["assessment_type", "overall", "summary"],
      "properties": {
        "assessment_type": { "type": "string", "minLength": 1 },
        "subject_ref": { "type": "string" },
        "overall": { "enum": ["pass", "warn", "fail", "unknown"] },
        "summary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/AssessmentDimension" } },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/AssessmentIssue" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "ResourceItem": {
      "type": "object",
      "required": ["resource_id", "title", "relation"],
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "relation": { "enum": ["source", "citation", "attachment", "input", "output"] },
        "mime_type": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "access": { "enum": ["public", "authorized", "private", "redacted"] },
        "last_modified": { "type": "string", "format": "date-time" },
        "priority": { "type": "number", "minimum": 0, "maximum": 1 },
        "locator": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "ResourcePayload": {
      "type": "object",
      "required": ["resources"],
      "properties": {
        "resources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ResourceItem" } }
      },
      "additionalProperties": true
    },
    "PrimitiveStringField": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": { "const": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "default": { "type": "string" },
        "enum": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "format": { "enum": ["date", "time", "date-time", "email", "uri"] }
      },
      "additionalProperties": false
    },
    "PrimitiveNumberField": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": { "enum": ["number", "integer"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "default": { "type": "number" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      },
      "additionalProperties": false
    },
    "PrimitiveBooleanField": {
      "type": "object",
      "required": ["type", "title"],
      "properties": {
        "type": { "const": "boolean" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "default": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "PrimitiveStringArrayField": {
      "type": "object",
      "required": ["type", "title", "items"],
      "properties": {
        "type": { "const": "array" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "string" } },
          "additionalProperties": false
        },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "uniqueItems": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "PrimitiveField": {
      "oneOf": [
        { "$ref": "#/$defs/PrimitiveStringField" },
        { "$ref": "#/$defs/PrimitiveNumberField" },
        { "$ref": "#/$defs/PrimitiveBooleanField" },
        { "$ref": "#/$defs/PrimitiveStringArrayField" }
      ]
    },
    "RestrictedResponseSchema": {
      "type": "object",
      "required": ["type", "properties"],
      "properties": {
        "$schema": { "type": "string" },
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/PrimitiveField" }
        },
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "InteractionOption": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "recommended": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "InteractionField": {
      "type": "object",
      "required": ["field_id", "label", "value_type", "required"],
      "properties": {
        "field_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "value_type": {
          "enum": ["text", "number", "boolean", "single_choice", "multiple_choice"]
        },
        "required": { "type": "boolean" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/InteractionOption" } },
        "allow_custom": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "SafeAction": {
      "type": "object",
      "required": ["action_id", "label", "intent"],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "intent": { "enum": ["submit", "choose", "accept", "decline", "cancel", "retry"] },
        "style": { "enum": ["default", "primary", "danger"] },
        "requires_confirmation": { "type": "boolean" },
        "disabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "DecisionContext": {
      "type": "object",
      "properties": {
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "effect_summary": { "type": "string" },
        "data_scope": { "type": "string" },
        "external_effect": { "type": "boolean" },
        "allowed_scopes": {
          "type": "array",
          "items": { "enum": ["once", "run", "persistent"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "InteractionPayload": {
      "type": "object",
      "required": ["interaction_id", "intent", "prompt", "submission_mode"],
      "properties": {
        "interaction_id": { "type": "string", "minLength": 1 },
        "intent": { "enum": ["clarify", "confirm", "approve", "choose", "edit", "provide_input", "authenticate", "retry"] },
        "prompt": { "type": "string", "minLength": 1 },
        "submission_mode": { "enum": ["conversation", "action"] },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/InteractionField" } },
        "response_schema": { "$ref": "#/$defs/RestrictedResponseSchema" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/InteractionOption" } },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SafeAction" } },
        "subject_ref": { "type": "string" },
        "subject_revision": { "type": "integer", "minimum": 0 },
        "decision_context": { "$ref": "#/$defs/DecisionContext" },
        "resume_token": { "type": "string" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "submission_mode": { "const": "action" } } },
          "then": { "required": ["actions", "subject_ref", "subject_revision", "resume_token"] }
        },
        {
          "if": { "properties": { "submission_mode": { "const": "conversation" } } },
          "then": { "required": ["fields"] }
        }
      ],
      "additionalProperties": false
    },
    "NarrativeBlock": {
      "allOf": [
        { "$ref": "#/$defs/BlockBase" },
        {
          "properties": {
            "kind": { "const": "narrative" },
            "payload": { "$ref": "#/$defs/NarrativePayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "DataBlock": {
      "allOf": [
        { "$ref": "#/$defs/BlockBase" },
        {
          "properties": {
            "kind": { "const": "data" },
            "payload": { "$ref": "#/$defs/DataPayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "WorkflowBlock": {
      "allOf": [
        { "$ref": "#/$defs/BlockBase" },
        {
          "properties": {
            "kind": { "const": "workflow" },
            "payload": { "$ref": "#/$defs/WorkflowPayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ArtifactBlock": {
      "allOf": [
        { "$ref": "#/$defs/BlockBase" },
        {
          "properties": {
            "kind": { "const": "artifact" },
            "payload": { "$ref": "#/$defs/ArtifactPayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "AssessmentBlock": {
      "allOf": [
        { "$ref": "#/$defs/BlockBase" },
        {
          "properties": {
            "kind": { "const": "assessment" },
            "payload": { "$ref": "#/$defs/AssessmentPayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "ResourceBlock": {
      "allOf": [
        { "$ref": "#/$defs/BlockBase" },
        {
          "properties": {
            "kind": { "const": "resource" },
            "payload": { "$ref": "#/$defs/ResourcePayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "InteractionBlock": {
      "allOf": [
        { "$ref": "#/$defs/BlockBase" },
        {
          "properties": {
            "kind": { "const": "interaction" },
            "payload": { "$ref": "#/$defs/InteractionPayload" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Block": {
      "oneOf": [
        { "$ref": "#/$defs/NarrativeBlock" },
        { "$ref": "#/$defs/DataBlock" },
        { "$ref": "#/$defs/WorkflowBlock" },
        { "$ref": "#/$defs/ArtifactBlock" },
        { "$ref": "#/$defs/AssessmentBlock" },
        { "$ref": "#/$defs/ResourceBlock" },
        { "$ref": "#/$defs/InteractionBlock" }
      ]
    },
    "Section": {
      "type": "object",
      "required": ["section_id", "role", "blocks"],
      "properties": {
        "section_id": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/SectionRole" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "$ref": "#/$defs/WorkStatus" },
        "order": { "type": "integer" },
        "presentation_hint": { "$ref": "#/$defs/PresentationHint" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/Block" } }
      },
      "additionalProperties": false
    },
    "Surface": {
      "type": "object",
      "required": ["surface_id", "status", "revision", "sections"],
      "properties": {
        "surface_id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/WorkStatus" },
        "revision": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/Section" } },
        "annotations": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "RemovePayload": {
      "type": "object",
      "required": ["revision"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AppendPayload": {
      "type": "object",
      "required": ["path", "value", "base_revision", "revision"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "value": {},
        "base_revision": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "JsonPatchOperation": {
      "type": "object",
      "required": ["op", "path"],
      "properties": {
        "op": { "enum": ["add", "remove", "replace", "test"] },
        "path": { "type": "string", "pattern": "^/" },
        "value": {}
      },
      "additionalProperties": false
    },
    "PatchPayload": {
      "type": "object",
      "required": ["operations", "base_revision", "revision"],
      "properties": {
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/JsonPatchOperation" } },
        "base_revision": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "CompletePayload": {
      "type": "object",
      "required": ["status", "revision"],
      "properties": {
        "status": { "$ref": "#/$defs/WorkStatus" },
        "revision": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string" },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "InteractionResolutionEvent": {
      "type": "object",
      "required": ["interaction_id", "action"],
      "properties": {
        "interaction_id": { "type": "string" },
        "action": { "enum": ["submit", "choose", "accept", "decline", "cancel", "retry"] },
        "resolved_by": { "enum": ["user", "policy", "operator", "system"] },
        "summary": { "type": "string" }
      },
      "additionalProperties": true
    },
    "ErrorPayload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "scope": { "enum": ["stream", "run", "surface", "section", "block"] }
      },
      "additionalProperties": true
    },
    "HeartbeatPayload": {
      "type": "object",
      "properties": {
        "server_time": { "type": "string", "format": "date-time" },
        "last_committed_seq": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "EventEnvelope": {
      "type": "object",
      "required": [
        "object_type",
        "protocol_version",
        "event_id",
        "event_type",
        "context_id",
        "run_id",
        "seq",
        "timestamp",
        "commit_state",
        "payload"
      ],
      "properties": {
        "object_type": { "const": "surface.event" },
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "event_id": { "type": "string", "minLength": 1 },
        "event_type": {
          "enum": [
            "run.started",
            "run.status",
            "run.finished",
            "surface.snapshot",
            "section.upsert",
            "section.remove",
            "block.create",
            "block.append",
            "block.patch",
            "block.complete",
            "block.remove",
            "interaction.resolved",
            "stream.error",
            "stream.heartbeat"
          ]
        },
        "context_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string" },
        "turn_id": { "type": "string" },
        "message_id": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "timestamp": { "type": "string", "format": "date-time" },
        "commit_state": { "enum": ["provisional", "committed"] },
        "transient": { "type": "boolean", "default": false },
        "target": { "$ref": "#/$defs/EntityTarget" },
        "trace": { "$ref": "#/$defs/TraceContext" },
        "payload": {}
      },
      "allOf": [
        {
          "if": { "properties": { "event_type": { "enum": ["run.started", "run.status", "run.finished"] } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/RunStatePayload" } } }
        },
        {
          "if": { "properties": { "event_type": { "const": "surface.snapshot" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/Surface" } } }
        },
        {
          "if": { "properties": { "event_type": { "const": "section.upsert" } } },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "$ref": "#/$defs/SectionTarget" },
              "payload": { "$ref": "#/$defs/Section" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "enum": ["section.remove", "block.remove"] } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/RemovePayload" } } }
        },
        {
          "if": { "properties": { "event_type": { "const": "section.remove" } } },
          "then": {
            "required": ["target"],
            "properties": { "target": { "$ref": "#/$defs/SectionTarget" } }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "block.remove" } } },
          "then": {
            "required": ["target"],
            "properties": { "target": { "$ref": "#/$defs/BlockTarget" } }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "block.create" } } },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "$ref": "#/$defs/SectionTarget" },
              "payload": { "$ref": "#/$defs/Block" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "block.append" } } },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "$ref": "#/$defs/BlockTarget" },
              "payload": { "$ref": "#/$defs/AppendPayload" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "block.patch" } } },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "$ref": "#/$defs/BlockTarget" },
              "payload": { "$ref": "#/$defs/PatchPayload" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "block.complete" } } },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "$ref": "#/$defs/BlockTarget" },
              "payload": { "$ref": "#/$defs/CompletePayload" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "interaction.resolved" } } },
          "then": {
            "required": ["target"],
            "properties": {
              "target": { "$ref": "#/$defs/BlockTarget" },
              "payload": { "$ref": "#/$defs/InteractionResolutionEvent" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "stream.error" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/ErrorPayload" } } }
        },
        {
          "if": { "properties": { "event_type": { "const": "stream.heartbeat" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/HeartbeatPayload" } } }
        }
      ],
      "additionalProperties": false
    },
    "InteractionResponse": {
      "type": "object",
      "required": [
        "object_type",
        "protocol_version",
        "context_id",
        "run_id",
        "interaction_id",
        "action_id",
        "action",
        "expected_revision",
        "idempotency_key",
        "resume_token",
        "timestamp"
      ],
      "properties": {
        "object_type": { "const": "interaction.response" },
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "context_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "interaction_id": { "type": "string", "minLength": 1 },
        "action_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["submit", "choose", "accept", "decline", "cancel", "retry"] },
        "values": { "type": "object", "additionalProperties": true },
        "approval_scope": { "enum": ["once", "run", "persistent"] },
        "expected_revision": { "type": "integer", "minimum": 0 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "resume_token": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ModelBlockBase": {
      "type": "object",
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "$ref": "#/$defs/BlockKind" },
        "title": { "type": "string" },
        "semantic": { "type": "string" },
        "payload": {},
        "presentation_hint": { "$ref": "#/$defs/PresentationHint" },
        "annotations": { "type": "object", "additionalProperties": true }
      }
    },
    "ModelWorkItem": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/WorkStatus" },
        "detail": { "type": "string" },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "ModelWorkflowPayload": {
      "type": "object",
      "required": ["scope", "items"],
      "properties": {
        "scope": { "enum": ["plan", "task", "step", "tool_call", "loop", "validation"] },
        "summary": { "type": "string" },
        "current_key": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ModelWorkItem" } }
      },
      "additionalProperties": false
    },
    "ModelArtifactPayload": {
      "type": "object",
      "required": ["artifact_type", "content_type", "content"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "content_type": { "type": "string", "minLength": 1 },
        "content_schema_version": { "type": "string" },
        "content": {},
        "change_summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ModelResourceItem": {
      "type": "object",
      "required": ["title", "relation"],
      "properties": {
        "uri": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "relation": { "enum": ["source", "citation", "attachment", "input", "output"] },
        "mime_type": { "type": "string" },
        "priority": { "type": "number", "minimum": 0, "maximum": 1 },
        "locator": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "ModelResourcePayload": {
      "type": "object",
      "required": ["resources"],
      "properties": {
        "resources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ModelResourceItem" } }
      },
      "additionalProperties": false
    },
    "ModelActionIntent": {
      "type": "object",
      "required": ["intent", "label"],
      "properties": {
        "intent": { "enum": ["submit", "choose", "accept", "decline", "cancel", "retry"] },
        "label": { "type": "string", "minLength": 1 },
        "style": { "enum": ["default", "primary", "danger"] }
      },
      "additionalProperties": false
    },
    "ModelInteractionPayload": {
      "type": "object",
      "required": ["intent", "prompt"],
      "properties": {
        "intent": { "enum": ["clarify", "confirm", "approve", "choose", "edit", "provide_input", "authenticate", "retry"] },
        "prompt": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/InteractionField" } },
        "response_schema": { "$ref": "#/$defs/RestrictedResponseSchema" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/InteractionOption" } },
        "suggested_actions": { "type": "array", "items": { "$ref": "#/$defs/ModelActionIntent" } },
        "decision_summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ModelBlockDraft": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/ModelBlockBase" },
            { "properties": { "kind": { "const": "narrative" }, "payload": { "$ref": "#/$defs/NarrativePayload" } } }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ModelBlockBase" },
            { "properties": { "kind": { "const": "data" }, "payload": { "$ref": "#/$defs/DataPayload" } } }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ModelBlockBase" },
            { "properties": { "kind": { "const": "workflow" }, "payload": { "$ref": "#/$defs/ModelWorkflowPayload" } } }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ModelBlockBase" },
            { "properties": { "kind": { "const": "artifact" }, "payload": { "$ref": "#/$defs/ModelArtifactPayload" } } }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ModelBlockBase" },
            { "properties": { "kind": { "const": "assessment" }, "payload": { "$ref": "#/$defs/AssessmentPayload" } } }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ModelBlockBase" },
            { "properties": { "kind": { "const": "resource" }, "payload": { "$ref": "#/$defs/ModelResourcePayload" } } }
          ],
          "unevaluatedProperties": false
        },
        {
          "allOf": [
            { "$ref": "#/$defs/ModelBlockBase" },
            { "properties": { "kind": { "const": "interaction" }, "payload": { "$ref": "#/$defs/ModelInteractionPayload" } } }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "ModelSectionDraft": {
      "type": "object",
      "required": ["role", "blocks"],
      "properties": {
        "role": { "$ref": "#/$defs/SectionRole" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/ModelBlockDraft" } }
      },
      "additionalProperties": false
    },
    "ModelSurfaceDraft": {
      "type": "object",
      "required": ["object_type", "protocol_version", "sections"],
      "properties": {
        "object_type": { "const": "model.surface_draft" },
        "protocol_version": { "$ref": "#/$defs/ProtocolVersion" },
        "title": { "type": "string" },
        "purpose": { "type": "string" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ModelSectionDraft" } }
      },
      "additionalProperties": false
    },
    "ClientCapabilities": {
      "type": "object",
      "required": ["object_type", "protocol_versions", "supported_block_kinds", "supported_renderers"],
      "properties": {
        "object_type": { "const": "client.capabilities" },
        "protocol_versions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "supported_block_kinds": { "type": "array", "items": { "$ref": "#/$defs/BlockKind" }, "uniqueItems": true },
        "supported_renderers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "supports_json_patch": { "type": "boolean" },
        "supports_resume": { "type": "boolean" },
        "max_inline_bytes": { "type": "integer", "minimum": 0 },
        "locale": { "type": "string" },
        "timezone": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}

  "schemas": {
    "input": {
      "$id": "indicator_series_query.input.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "indicator_ids": {
          "type": "array",
          "description": "指标 ID 列表。当前支持 close_ma_5、close_ma_10、close_ma_20。",
          "items": {
            "type": "string",
            "enum": [
              "close_ma_5",
              "close_ma_10",
              "close_ma_20"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "range_days": {
          "type": "integer",
          "description": "返回最近多少个交易日的数据点，默认 30。",
          "minimum": 1,
          "maximum": 365
        },
        "subject_codes": {
          "type": "array",
          "description": "主体标准代码列表，例如 [\"000001.SH\"] 或 [\"600519.SH\"]。",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "indicator_ids"
      ],
      "type": "object"
    },
    "output": {
      "$ref": "src/tools/schemas/indicator_series_query.schema.json"
    }
  },

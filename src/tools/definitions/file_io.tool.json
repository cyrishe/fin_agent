{
  "name": "file_io",
  "version": "v1",
  "status": "active",
  "auth": "public",
  "availability": {
    "lifecycle": "active",
    "retrieval_mode": "retrievable",
    "visibility": "visible"
  },
  "identity": {
    "display_name": "文件读写",
    "description": "统一文件读写工具。读取时按文件后缀或 MIME 规则路由 CSV、Excel、Word、文本等解析器；写入时生成 runtime artifact，不直接覆盖本地文件。",
    "domain": "file_io",
    "owner": "tools"
  },
  "match_contract": {
    "request_families": [
      "data_access",
      "file_operation"
    ],
    "work_item_types": [
      "tool"
    ],
    "capability_classes": [
      "file_io",
      "file_read",
      "file_write",
      "table_file_read",
      "document_artifact"
    ],
    "side_effect_level": "write_runtime_artifact"
  },
  "capabilities": [
    "file_io",
    "file_read",
    "file_write",
    "table_read",
    "document_read",
    "runtime_artifact"
  ],
  "tags": [
    "file",
    "io",
    "csv",
    "excel",
    "word",
    "txt",
    "artifact"
  ],
  "schemas": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "file_io.input.schema.json",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ],
          "description": "文件操作。read 读取文件；write 写入 runtime artifact。"
        },
        "file_path": {
          "type": "string",
          "description": "本地文件路径。读取 CSV/TSV/XLSX/TXT 可用；Word 建议使用 file_id。"
        },
        "file_id": {
          "type": "string",
          "description": "上传文件 id 或 runtime://artifact/<id>。"
        },
        "file_type": {
          "type": "string",
          "enum": [
            "auto",
            "csv",
            "tsv",
            "excel",
            "word",
            "text",
            "txt",
            "json",
            "pdf",
            "table"
          ],
          "description": "可选。为空或 auto 时按后缀判断。"
        },
        "content": {
          "type": "string",
          "description": "写入文档或表格的内容。write 时使用。"
        },
        "rows": {
          "type": "array",
          "description": "写入表格 artifact 的行数据。"
        },
        "header": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_name": {
          "type": "string",
          "description": "写入 artifact 的建议文件名。"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000,
          "default": 50000
        },
        "max_preview_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }
    },
    "output": {
      "$ref": "src/tools/schemas/file_io.schema.json"
    }
  },
  "profiles": {
    "real": {
      "enabled": true,
      "implementation": {
        "kind": "python_callable",
        "target": "src.tools.file_io_tool:run"
      }
    },
    "mock": {
      "enabled": true,
      "implementation": {
        "kind": "inline_result"
      },
      "result": {
        "tool": "file_io",
        "ok": true,
        "data": {
          "mode": "read",
          "file_type": "csv",
          "data": {
            "header": [],
            "rows": []
          }
        },
        "error": ""
      }
    }
  },
  "retention": {
    "high_value_for_reasoning": [
      "data.file_type",
      "data.data.header",
      "data.data.rows",
      "data.data.document.preview_text",
      "data.artifact_ref"
    ],
    "high_value_for_render": [
      "data.data.header",
      "data.data.rows",
      "data.data.document.preview_text"
    ],
    "usually_too_large_for_prompt": [
      "data.data.rows",
      "data.data.document.preview_text"
    ],
    "drop_default": [],
    "recommended_reducers": {
      "data.data.rows": "head:20",
      "data.data.document.preview_text": "truncate:5000"
    }
  },
  "safety": {
    "network": false,
    "persistence": true,
    "side_effect": "write_runtime_artifact"
  },
  "runtime_hints": {
    "cost_class": "low",
    "latency_class": "medium",
    "supports_stream": false,
    "supports_async_submit": false
  },
  "tests": {
    "sample_inputs": [
      {
        "name": "read_csv",
        "arguments": {
          "action": "read",
          "file_path": "/tmp/sample.csv"
        }
      },
      {
        "name": "write_text_artifact",
        "arguments": {
          "action": "write",
          "file_type": "text",
          "content": "hello"
        }
      }
    ]
  },
  "ui_hints": {
    "editable_sections": [
      "identity",
      "schemas.input",
      "schemas.output",
      "retention",
      "tests"
    ]
  },
  "subject_tags": [
    "general"
  ],
  "tool_priority": 1
}

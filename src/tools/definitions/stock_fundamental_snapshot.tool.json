{
  "auth": "public",
  "availability": {
    "lifecycle": "active",
    "retrieval_mode": "retrievable",
    "visibility": "visible"
  },
  "capabilities": [
    "stock_profile",
    "company_profile"
  ],
  "defaults": {},
  "identity": {
    "description": "获取单只 A 股的基础资料和公司资料快照。",
    "display_name": "个股基础资料查询",
    "domain": "stock",
    "owner": "tools"
  },
  "invocation_example": "stock_fundamental_snapshot(stock=\"贵州茅台\")",
  "match_contract": {
    "request_families": [
      "data_access"
    ],
    "work_item_types": [
      "tool"
    ],
    "capability_classes": [
      "data_retrieval",
      "fundamental_lookup"
    ],
    "side_effect_level": "read_only"
  },
  "name": "stock_fundamental_snapshot",
  "post_process": {
    "deterministic": {
      "enabled": false,
      "handler": ""
    },
    "llm": {
      "enabled": false,
      "prompt_key": ""
    }
  },
  "profiles": {
    "mock": {
      "enabled": true,
      "implementation": {
        "kind": "inline_result"
      },
      "result": {
        "data": {
          "subject": "贵州茅台",
          "code": "600519.SH",
          "name": "贵州茅台",
          "profile": {}
        },
        "error": "",
        "ok": true,
        "tool": "stock_fundamental_snapshot"
      }
    },
    "real": {
      "enabled": true,
      "implementation": {
        "kind": "python_callable",
        "target": "src.tools.stock_fundamental_snapshot_tool:run"
      }
    }
  },
  "retention": {
    "drop_default": [],
    "high_value_for_reasoning": [
      "data.code",
      "data.name",
      "data.profile"
    ],
    "high_value_for_render": [],
    "recommended_reducers": {
      "data.profile.brief_intro": "truncate_text",
      "data.profile.business_major": "truncate_text"
    },
    "usually_too_large_for_prompt": [
      "data.profile.brief_intro",
      "data.profile.business_major"
    ]
  },
  "runtime_hints": {
    "cost_class": "low",
    "latency_class": "low",
    "supports_async_submit": false,
    "supports_stream": false
  },
  "safety": {
    "network": true,
    "persistence": false,
    "side_effect": "none"
  },
  "schemas": {
    "input": {
      "$id": "stock_fundamental_snapshot.input.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "stock": {
          "description": "股票代码、简称或名称。",
          "type": "string"
        }
      },
      "required": [
        "stock"
      ],
      "type": "object"
    },
    "output": {
      "$ref": "src/tools/schemas/stock_fundamental_snapshot.schema.json"
    }
  },
  "status": "active",
  "tags": [
    "stock",
    "profile",
    "company_profile"
  ],
  "tests": {

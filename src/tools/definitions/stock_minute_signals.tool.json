{
  "auth": "public",
  "availability": {
    "lifecycle": "active",
    "retrieval_mode": "retrievable",
    "visibility": "visible"
  },
  "capabilities": [
    "minute_signal_replay",
    "scheduled_signal_observation"
  ],
  "identity": {
    "description": "逐根检查当日完整分钟K，返回均线穿越、连续站稳、session MACD交叉和量能扩张事件及当前条件。普通调用按需回放；用于已有定时任务时按任务归属保存首次发现、修订与事件证据，不发送通知，不调用模型或上游行情API。",
    "display_name": "分钟技术信号检查",
    "domain": "stock",
    "owner": "tools"
  },
  "invocation_example": "stock_minute_signals(codes=[\"600519.SH\"], period=5, rules=[\"ma20_cross_up\",\"ma20_hold_above\"])",
  "match_contract": {
    "request_families": [
      "data_access",
      "monitoring"
    ],
    "work_item_types": [
      "tool"
    ],
    "capability_classes": [
      "technical_analysis",
      "signal_observation"
    ],
    "side_effect_level": "write"
  },
  "name": "stock_minute_signals",
  "profiles": {
    "mock": {
      "enabled": true,
      "implementation": {
        "kind": "inline_result"
      },
      "result": {
        "tool": "stock_minute_signals",
        "ok": true,
        "data": {
          "events": [],
          "current_conditions": [],
          "external_requests": 0
        },
        "error": ""
      }
    },
    "real": {
      "enabled": true,
      "implementation": {
        "kind": "python_callable",
        "target": "src.tools.stock_minute_signals_tool:run"
      }
    }
  },
  "runtime_hints": {
    "cost_class": "low",
    "latency_class": "medium",
    "supports_async_submit": false,
    "supports_stream": false
  },
  "safety": {
    "network": true,
    "persistence": true,
    "side_effect": "write"
  },
  "schemas": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "stock_minute_signals.input.schema.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codes"
      ],
      "properties": {
        "codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"
          },
          "description": "去重股票范围；每20只共用一次分钟读取。"
        },
        "period": {
          "type": "integer",
          "enum": [
            1,
            3,
            5,
            10,
            15,
            30,
            60
          ],
          "default": 5,
          "description": "分析K线周期，不是任务执行间隔。"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ma20_cross_up",
              "ma20_cross_down",
              "ma20_hold_above",
              "session_macd_cross_up",
              "session_macd_cross_down",
              "volume_expansion"
            ]
          },
          "description": "启用的确定性规则，省略时检查MA20上下穿。"
        },
        "confirm_bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 3
        },
        "volume_ratio_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.5
        },
        "as_of": {
          "type": "string",
          "description": "带时区的历史截止时间，仅供普通回放；定时监控省略。"
        },
        "since": {
          "type": "string",
          "description": "仅临时回放可用，同一交易日事件时间下界（不包含）；定时任务自动检查当日完整区间。"
        },
        "max_lag_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "允许的输入滞后上限；超过时保留原因，不以旧行情产生新事件。"
        }
      }
    },
    "output": {
      "$ref": "src/tools/schemas/stock_minute_signals.schema.json"
    }
  },
  "status": "active",
  "tags": [
    "stock",
    "technical",
    "signals"
  ],
  "tests": {
    "golden_cases": [],
    "sample_inputs": [
      {
        "name": "completed_bar_signal_replay",

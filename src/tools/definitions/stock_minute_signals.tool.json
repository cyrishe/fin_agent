            "600519.SH"
          ],
          "period": 5,
          "rules": [
            "ma20_cross_up",
            "ma20_hold_above"
          ]
        }
      }
    ]
  },
  "version": "v1",
  "subject_tags": [
    "stock"
  ],
  "tool_priority": 1
}

{
  "name": "task_submit",
  "version": "v1",
  "status": "active",
  "availability": {
    "lifecycle": "active",
    "retrieval_mode": "retrievable"
  },
  "identity": {
    "display_name": "提交后台任务",
    "description": "用户明确要求后台、多步、定时或 AutoML 研究时提交任务，返回回执和任务中心链接。保留完整目标和约束；实际工作由独立 worker 执行。",
    "domain": "user_tasks",
    "owner": "tools"
  },
  "schemas": {
    "input": {
      "type": "object",
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "完整的用户任务目标、约束、时间和预算要求"
        },
        "idempotency_key": {
          "type": "string",
          "maxLength": 128,
          "description": "重复提交同一次请求时复用的标识；通常由系统生成"
        }
      },
      "required": [
        "instruction"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object"
    }
  },
  "profiles": {
    "real": {
      "enabled": true,
      "implementation": {
        "kind": "python_callable",
        "target": "src.tools.user_task_tools:run_submit"
      }
    }
  },
  "safety": {
    "network": false,
    "persistence": true,
    "side_effect": "write_user_task"
  },
  "runtime_hints": {
    "cost_class": "low",
    "latency_class": "short",
    "supports_async_submit": true
  },
  "auth": "internal"
}

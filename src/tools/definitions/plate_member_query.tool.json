  "schemas": {
    "input": {
      "$id": "plate_member_query.input.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "description": "板块代码/名称，或股票代码/名称。",
          "type": "string"
        },
        "subject_type": {
          "description": "查询主体类型；auto 会做轻量代码形态判断。",
          "enum": [
            "auto",
            "plate",
            "stock"
          ],
          "type": "string"
        },
        "trade_date": {
          "description": "行情和资金字段的截止交易日，YYYY-MM-DD；为空时取最近记录。",
          "type": "string"
        },
        "limit": {
          "description": "返回关系行数，默认 50。",
          "minimum": 1,
          "maximum": 500,
          "type": "integer"
        },
        "sort_by": {
          "description": "排序字段。",
          "enum": [
            "stock_code",
            "stock_rise_fall_rate",
            "stock_amount",
            "stock_main_net_inflow",
            "plate_rise_fall_rate",
            "plate_amount",
            "plate_main_net_inflow"
          ],
          "type": "string"
        }
      },
      "required": [
        "subject"
      ],
      "type": "object"
    },
    "output": {
      "$ref": "src/tools/schemas/plate_member_query.schema.json"
    }

          "description": "截止交易日，YYYY-MM-DD；为空时取最近数据。",
          "type": "string"
        },
        "days": {
          "description": "最多返回最近 N 条，默认 20。",
          "maximum": 250,
          "minimum": 1,
          "type": "integer"
        },
        "granularity": {
          "description": "资金流序列粒度。",
          "enum": [
            "daily",
            "minute"
          ],
          "type": "string"
        },
        "limit": {
          "description": "底层查询保护上限，默认 50。",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "subject_type"
      ],
      "type": "object"
    },
    "output": {
      "$ref": "src/tools/schemas/capital_flow_query.schema.json"

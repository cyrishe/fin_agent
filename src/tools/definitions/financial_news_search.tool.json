      "enabled": true,
      "implementation": {
        "kind": "inline_result"
      },
      "result": {
        "data": [
          {
            "publish_time": "publish_time_示例",
            "site": "site_示例",
            "snippet": "snippet_示例",
            "title": "title_示例",
            "url": "url_示例"
          }
        ],
        "error": "error_示例",

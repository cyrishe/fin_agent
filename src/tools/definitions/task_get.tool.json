        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object"
    }
  },
  "profiles": {
    "real": {
      "enabled": true,
      "implementation": {
        "kind": "python_callable",
        "target": "src.tools.user_task_tools:run_get"
      }
    }
  },
  "safety": {
    "network": false,
    "persistence": false,
    "side_effect": "read"
  },
  "runtime_hints": {
    "cost_class": "low",
    "latency_class": "short",
    "supports_async_submit": false
  },
  "auth": "internal"

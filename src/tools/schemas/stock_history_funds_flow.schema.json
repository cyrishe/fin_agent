{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stock_history_funds_flow.schema.json",
  "title": "Stock History Funds Flow Output",
  "type": "object",
  "required": [
    "tool",
    "ok",
    "data",
    "error"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "code",
        "history",
        "name",
        "source"
      ],
      "properties": {
        "code": {
          "description": "股票代码",
          "type": "string"
        },
        "history": {
          "description": "近期历史资金列表",
          "items": {
            "$ref": "#/$defs/row"
          },
          "type": "array"
        },
        "name": {
          "description": "股票名称",
          "type": "string"
        },
        "source": {
          "description": "数据来源",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "error": {
      "description": "错误信息，成功时为空",
      "type": "string"
    },
    "ok": {
      "description": "执行是否成功",
      "type": "boolean"
    },
    "tool": {
      "const": "stock_history_funds_flow",
      "description": "工具标识"
    }
  },
  "additionalProperties": false
}

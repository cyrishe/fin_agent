+describe('temporary history scope', () => {
+  it('sends only the selected turn, retains its tool pairs, and restores earlier evidence for a follow-up', async () => {
+    const adapter = new MockAdapter([
+      textResponse('earlier answer'),
+      toolCallResponse('scope-tool', 'proof', {}),
+      textResponse('independent answer'),
+      textResponse('follow-up answer'),
+    ])
+    const ctx = await harness(adapter)
+    ctx.tools.register(defineContentToolFixture({ name: 'proof', description: 'Proof',
+      parameters: {},
+      execute: async () => [{ type: 'text', text: 'current evidence' }],
+    }))
+    const agent = ctx.agentLoop.create(SessionId('temporary-scope'), { provider: 'mock', model: 'mock' })
+    agent.ctx.on('agent/pre-step', async ({ turn }, next) => {
+      const fromTurn = turn === 2 ? 2 : undefined
+      if (agent.session.requestHistory().fromTurn !== fromTurn) {
+        agent.session.append('request/history', fromTurn === undefined ? {} : { fromTurn })
+      }
+      return next()
+    })
+    for (const question of ['earlier question', 'independent question', 'return to the earlier question']) {
+      send(agent, question)
+      await waitForIdle(ctx, agent)
+    }
+    expect(adapter.requests).toHaveLength(4)
+    for (const request of adapter.requests.slice(1, 3)) {
+      expect(JSON.stringify(request.messages)).not.toContain('earlier answer')
+      expect(JSON.stringify(request.messages)).toContain('independent question')
+    }
+    expect(JSON.stringify(adapter.requests[2]?.messages)).toContain('current evidence')
+    expect(JSON.stringify(adapter.requests[3]?.messages)).toContain('earlier answer')
+    expect(JSON.stringify(adapter.requests[3]?.messages)).toContain('independent answer')
+    expect(agent.session.events.filter(event => event.type === 'request/history')).toHaveLength(2)
+    // Reconstruct every exact request boundary solely from the durable log.
+    const ends = agent.session.events.filter(event => event.type === 'assistant/message')
+    for (const [index, event] of ends.entries()) {
+      const replay = Session.create(SessionId(`scope-replay-${index}`), agent.session.events.slice(0, event.seq))
+      expect(replay.deriveMessages()).toEqual(adapter.requests[index]?.messages)
+    }
+  })
+})
+

diff --git a/packages/core/session/tests/request-history.spec.ts b/packages/core/session/tests/request-history.spec.ts
new file mode 100644
index 0000000000..31647943e8
--- /dev/null
+++ b/packages/core/session/tests/request-history.spec.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from 'vitest'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { createUserMessage, createMessage } from '@deepseek-ai/dsh-llm'
+
+function user(session: Session, text: string) {
+  session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text }], source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+}
+
+describe('request history selection', () => {
+  it('keeps the archive intact, replays a selected turn, and restores the complete view', () => {
+    const session = Session.create(SessionId('request-history'))
+    session.append('turn/start', { turn: 1 })
+    user(session, 'earlier question and complete evidence')
+    session.append('assistant/message', { turn: 1, step: 1,
+      message: createMessage({ role: 'assistant', content: [{ type: 'text', text: 'earlier answer' }],
+        source: { kind: 'model', provider: 'mock', model: 'mock' } }),
+    }, { surfaceOp: 'append' })
+    session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+    const archive = [...session.events]
+    session.append('turn/start', { turn: 2 })
+    session.append('request/history', { fromTurn: 2 })
+    user(session, 'independent question')
+    const selected = session.deriveMessages()
+    expect(selected).toHaveLength(1)
+    expect(JSON.stringify(selected)).not.toContain('earlier')
+    expect(session.events.slice(0, archive.length)).toEqual(archive)
+    expect(session.surface.nodes).toHaveLength(3)
+    const replay = Session.create(SessionId('request-history-replay'), [...session.events])
+    expect(replay.deriveMessages()).toEqual(selected)
+    replay.append('request/history', {})
+    expect(replay.deriveMessages()).toHaveLength(3)
+    expect(JSON.stringify(replay.deriveMessages())).toContain('earlier answer')
+    expect(selected).toHaveLength(1)
+    expect(Session.create(SessionId('restore-replay'), [...replay.events]).deriveMessages()).toEqual(replay.deriveMessages())
+  })
+
+  it('defaults legacy sessions to full history and refuses nonexistent or malformed boundaries', () => {
+    const session = Session.create(SessionId('request-history-invalid'))
+    session.append('turn/start', { turn: 1 })
+    user(session, 'keep me')
+    expect(session.requestHistory()).toEqual({})
+    const before = [...session.events]
+    for (const fromTurn of [0, -1, 1.5, 2, '1', null]) {
+      expect(() => session.append('request/history', { fromTurn } as { fromTurn: number })).toThrow(/existing turn/)
+      expect(session.events).toEqual(before)
+    }
+    expect(() => Session.create(SessionId('bad-replay'), [...before, {
+      seq: before.length, time: 1, type: 'request/history', data: { fromTurn: 2 },
+    }])).toThrow(/existing turn/)
+    session.append('request/history', {})
+    expect(session.deriveMessages()).toHaveLength(1)
+  })
+})

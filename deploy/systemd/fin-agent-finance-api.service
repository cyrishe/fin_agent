[Unit]
Description=Fin Agent Financial Data API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fin-agent
Group=fin-agent
WorkingDirectory=/opt/fin_agent
EnvironmentFile=/opt/fin_agent/.env
ExecStart=/opt/fin_agent/.venv/bin/python -m src.finance_api.app
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/fin_agent/data /opt/fin_agent/output

[Install]
WantedBy=multi-user.target

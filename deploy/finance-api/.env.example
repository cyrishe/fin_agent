# Fin Agent server deployment environment
# Copy this file to the repository root as .env and replace every CHANGE_ME value.
# Never copy a developer laptop's .env or commit the resulting server .env.

# Public financial REST/MCP service
FINANCE_API_HOST=0.0.0.0
FINANCE_API_PORT=22100
# Set this when Nginx publishes the service below a path such as /finance/.
FINANCE_API_ROOT_PATH=
FINANCE_API_DEFAULT_RUNTIME=dsh
FINANCE_API_MAX_CONCURRENCY=6
FINANCE_API_KEYS_JSON='{"internal":"CHANGE_ME_GENERATE_AT_LEAST_24_RANDOM_CHARACTERS"}'
FINANCE_API_ALLOWED_HOSTS=finance-api.example.com,finance-api.example.com:443,127.0.0.1:*
FINANCE_API_ALLOWED_ORIGINS=
FINANCE_API_CORS_ORIGINS=

# Shared financial database
KINGDOMAI_DB_URL=CHANGE_ME

# Financial data-query runtime (DeepSeek Harness)
FINANCE_DSH_FINANCIAL_QA_ENABLED=1
FINANCE_DSH_PROVIDER=deepseek-official
FINANCE_DSH_MODEL=deepseek-v4-flash
FINANCE_DSH_REASONING_EFFORT=low
FINANCE_DSH_WORKERS=3
FINANCE_DSH_MAX_TOKENS=8192
FINANCE_DSH_TURN_TIMEOUT_SECONDS=300
FINANCE_DSH_QUEUE_TIMEOUT_SECONDS=300
FINANCE_DSH_PREWARM_ON_START=1
FINANCE_DSH_PREWARM_WORKERS=3
FINANCE_DSH_API_KEY=CHANGE_ME
FINANCE_DSH_BASE_URL=https://api.deepseek.com
# To use a Bailian-compatible route instead, replace the previous two values:
# FINANCE_DSH_API_KEY=CHANGE_ME_BAILIAN_KEY
# FINANCE_DSH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# FINANCE_DSH_MODEL=CHANGE_ME_BAILIAN_MODEL_ID
# If dsh is not installed on PATH, point these to the installed runtime:
# FINANCE_DSH_BIN=/absolute/path/to/dsh
# FINANCE_DSH_SDK_SOURCE=/absolute/path/to/deepseek-harness/python/sdk/src
# FINANCE_DSH_SOURCE_ROOT=/absolute/path/to/deepseek-harness
# FINANCE_DSH_NODE_BIN=/absolute/path/to/node

# Codex SDK runtime on the server: explicit API-key mode fails closed and never
# falls back to a local ChatGPT subscription.
STOCK_AGENT_CODEX_AUTH_MODE=crs_api_key
CODEX_CRS_API_KEY=CHANGE_ME
CODEX_CRS_BASE_URL=https://proxy.kingdomai.com/openai
CODEX_CRS_MODEL=gpt-5-codex
CODEX_CRS_REASONING_EFFORT=high

# Bailian OpenAI-compatible access for lightweight/base-model calls.
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Claude Agent SDK over Bailian's Anthropic-compatible endpoint. Keep these if
# the server uses the Claude/DeepSeek agent adapter; otherwise they are harmless.
CLAUDE_PROVIDER=dashscope
CLAUDE_MODEL=deepseek-v4-flash
DASHSCOPE_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
CLAUDE_BASE_URL=

# Explicit base LLM settings avoid fallback to any personal local credential.
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=CHANGE_ME_BASE_MODEL_ID

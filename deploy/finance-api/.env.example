# Fin Agent server deployment environment
# Copy this file to the repository root as .env and replace every CHANGE_ME value.
# Never copy a developer laptop's .env or commit the resulting server .env.

# Public financial REST/MCP service
FINANCE_API_HOST=0.0.0.0
FINANCE_API_PORT=22100
# Set this when Nginx publishes the service below a path such as /finance/.
FINANCE_API_ROOT_PATH=
FINANCE_STATUS_ENABLED=1
FINANCE_STATUS_CHECK_TIME=15:30
FINANCE_STATUS_INTERVAL_SECONDS=900
FINANCE_STATUS_REALTIME_INTERVAL_SECONDS=60
FINANCE_STATUS_REALTIME_TOLERANCE_SECONDS=300
FINANCE_STATUS_SNAPSHOT_PATH=data/finance_status/latest.json
FINANCE_API_DEFAULT_RUNTIME=dsh
FINANCE_CHAT_DEFAULT_RUNTIME=dsh
FINANCE_API_MAX_CONCURRENCY=6
FINANCE_API_KEYS_JSON='{"internal":"CHANGE_ME_GENERATE_AT_LEAST_24_RANDOM_CHARACTERS"}'
# Optional server-controlled grants to an existing user's private published Skills.
# Example: {"internal":"existing-user-id"}. Unmapped keys use an isolated API owner.
FINANCE_API_OWNER_IDS_JSON='{}'
FINANCE_API_ALLOWED_HOSTS=finance-api.example.com,finance-api.example.com:443,127.0.0.1:*
FINANCE_API_ALLOWED_ORIGINS=
FINANCE_API_CORS_ORIGINS=

# System storage for conversations, users, tasks, and runtime state.
# Current deployment explicitly uses stock_agent with the existing account:
# mysql+pymysql://USER:URL_ENCODED_PASSWORD@47.94.1.2:3312/stock_agent?charset=utf8mb4
# Switch only after system-table migration passes; kingdomai remains financial data.
SYSTEM_DB_URL=CHANGE_ME

# Shared financial database. This is not the system-storage database.
KINGDOMAI_DB_URL=CHANGE_ME

# Canonical OpenAI-compatible model route. DSH uses these values directly;
# do not add a second runtime-specific model key or endpoint.
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=CHANGE_ME_BASE_MODEL_ID

# Financial data-query runtimes.  The web application defaults to cc when the
# request does not explicitly choose a runtime; keep both enabled on a dual-path
# deployment so financial questions do not fall back to the generic tool plan.
FINANCE_CC_FINANCIAL_QA_ENABLED=1
# Keep enabled when bubblewrap is installed. Set to 0 only on a host where CC
# cannot start because bubblewrap is unavailable; finance CC exposes no shell,
# file, web, or sub-agent tools in this mode.
FINANCE_CC_SUBPROCESS_ENV_SCRUB=1
FINANCE_DSH_FINANCIAL_QA_ENABLED=1
FINANCE_DSH_PROVIDER=deepseek-official
FINANCE_DSH_REASONING_EFFORT=low
FINANCE_DSH_WORKERS=3
FINANCE_DSH_MAX_TOKENS=8192
FINANCE_DSH_TURN_TIMEOUT_SECONDS=300
FINANCE_DSH_QUEUE_TIMEOUT_SECONDS=300
FINANCE_DSH_PREWARM_ON_START=1
FINANCE_DSH_PREWARM_WORKERS=3
# If dsh is not installed on PATH, point these to the installed runtime:
# FINANCE_DSH_BIN=/absolute/path/to/dsh
# Source deployments use scripts/dsh_source_runtime.sh so the project Python
# interpreter is explicit even on hosts where the `python3` command is not CPython.
# FINANCE_DSH_SDK_SOURCE=/absolute/path/to/deepseek-harness/python/sdk/src
# FINANCE_DSH_SOURCE_ROOT=/absolute/path/to/deepseek-harness
# FINANCE_DSH_NODE_BIN=/absolute/path/to/node

# Codex SDK runtime on the server: explicit API-key mode fails closed and never
# falls back to a local ChatGPT subscription.
STOCK_AGENT_CODEX_AUTH_MODE=crs_api_key
CODEX_CRS_API_KEY=CHANGE_ME
CODEX_CRS_BASE_URL=https://proxy.kingdomai.com/openai
CODEX_CRS_MODEL=gpt-6-astra
CODEX_CRS_REASONING_EFFORT=low
STOCK_AGENT_CUSTOM_TOOL_CODEX_MODEL=gpt-6-astra
STOCK_AGENT_CUSTOM_TOOL_CODEX_REASONING=low
STOCK_AGENT_CODEX_BIN=/home/che/cyris/runtime/codex-astra/node_modules/.bin/codex

# Bailian OpenAI-compatible access for lightweight/base-model calls.
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Claude Agent SDK over Bailian's Anthropic-compatible endpoint. Keep these if
# the server uses the Claude/DeepSeek agent adapter; otherwise they are harmless.
CLAUDE_PROVIDER=dashscope
CLAUDE_MODEL=deepseek-v4-flash-0731
DASHSCOPE_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
CLAUDE_BASE_URL=

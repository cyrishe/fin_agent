# 复制为部署环境变量或仓库根目录 .env，使用现场专用凭据；勿提交实际密码。
FINANCE_API_KEY=CHANGE_ME_AT_LEAST_24_RANDOM_CHARACTERS
FINANCE_API_HOST=127.0.0.1
FINANCE_API_PORT=22100
FINANCE_API_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# 密码中的特殊字符须 URL 编码；此连接仅需三张研报表的 SELECT 权限。
FINANCE_REPORT_DB_URL=mysql+pymysql://report_reader:CHANGE_ME@127.0.0.1:3306/report_db
FINANCE_REPORT_TABLE=reports
FINANCE_REPORT_METRIC_FACT_TABLE=metric_fact
FINANCE_REPORT_METRIC_DEF_TABLE=metric_def

# 模型及 DSH 环境需由现场提供。也可按既有文档配置 CC runtime。
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=CHANGE_ME
LLM_DEFAULT_MODEL=CHANGE_ME
FINANCE_API_DEFAULT_RUNTIME=dsh
FINANCE_DSH_FINANCIAL_QA_ENABLED=1
FINANCE_DSH_PREWARM_ON_START=0
# 可选：标准问答预装研报目录，减少首次目录选择的模型往返；设为 0 回退。
FINANCE_DSH_REPORT_CATALOG_PRELOAD=1
# FINANCE_DSH_BIN=/absolute/path/to/dsh
# FINANCE_DSH_SOURCE_ROOT=/absolute/path/to/fin_harness
# FINANCE_DSH_SDK_SOURCE=/absolute/path/to/fin_harness/python/sdk/src
# FINANCE_DSH_NODE_BIN=/absolute/path/to/node

# 默认不写系统数据库；仅配置并准备好 aiia_request_usage 表时启用。
FINANCE_API_USAGE_ENABLED=0

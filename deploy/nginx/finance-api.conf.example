server {
    listen 443 ssl http2;
    server_name finance-api.example.com;

    ssl_certificate /etc/letsencrypt/live/finance-api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/finance-api.example.com/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:22100;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}

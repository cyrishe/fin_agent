# LLM
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=deepseek-v4-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_PROXY_API_KEY=
OPENAI_PROXY_BASE_URL=http://api.openai-proxy.com/v1/
NEXT_API_KEY=
NEXT_API_BASE_URL=https://api.nextapi.fun/v1/

# Databases
PLATFORM_DB_URL=
BUSINESS_DB_URL=
SYSTEM_DB_URL=
REPORT_DB_URL=
KINGDOMAI_DB_PASSWORD=
STOCK_AGENT_DB_PASSWORD=

# Web
FIN_AGENT_PORT=22053
FIN_AGENT_FLASK_RELOADER=0

# Codex custom-tool runtime (idle / hard timeout, seconds)
STOCK_AGENT_CUSTOM_TOOL_CODEX_TIMEOUT_SECONDS=300
STOCK_AGENT_CUSTOM_TOOL_CODEX_HARD_TIMEOUT_SECONDS=1800
STOCK_AGENT_CUSTOM_TOOL_DIRECT_TIMEOUT_SECONDS=180
STOCK_AGENT_CUSTOM_TOOL_DIRECT_HARD_TIMEOUT_SECONDS=600

# Provider choices stay in the system adapter, outside the business protocol.
CUSTOM_TOOL_AGENT_ENABLED=1
CUSTOM_TOOL_DESIGN_PROVIDER=claude
CUSTOM_TOOL_DESIGN_COMPLEXITY=fast
CUSTOM_TOOL_CODING_PROVIDER=codex
CUSTOM_TOOL_CODING_COMPLEXITY=mid
# 测试 Skill 审阅真实结果并决定是否继续；系统以此限制最多规划/复核轮次。
CUSTOM_TOOL_TEST_MAX_TURNS=4
# 当前主链路禁用 Web Search 与 MCP。
CUSTOM_TOOL_AGENT_WEB_SEARCH=disabled
# 保持为空即不向 Agent 暴露任何 MCP server。
# Credentials must be referenced by environment-variable name inside the JSON file.
CUSTOM_TOOL_AGENT_MCP_CONFIG_PATH=

# Claude Agent SDK (default: DeepSeek official Anthropic endpoint + DeepSeek V4 Flash)
CLAUDE_PROVIDER=deepseek
CLAUDE_MODEL=deepseek-v4-flash
# Official provider endpoints are selected by the adapter. Set only for gateway/custom endpoints.
CLAUDE_BASE_URL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_AUTH_TOKEN=
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_TIMEOUT_SECONDS=300
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_HARD_TIMEOUT_SECONDS=1800
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_MAX_TURNS=20
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_MAX_BUDGET_USD=0
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_EFFORT=high

# Finance CC shadow session. It observes Finance turns but does not change routing, replies, or DB state.
FINANCE_CC_SHADOW_ENABLED=0
FINANCE_CC_PROVIDER=dashscope
FINANCE_CC_MODEL=deepseek-v4-flash
FINANCE_CC_EFFORT=low
FINANCE_CC_MAX_TURNS=20
FINANCE_CC_TURN_TIMEOUT_SECONDS=180
FINANCE_CC_LONG_TURN_TIMEOUT_SECONDS=900
FINANCE_CC_TOOL_DEVELOPMENT_ENABLED=1

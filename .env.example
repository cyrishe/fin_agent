# LLM
# DSH（包括研报 Skill）统一使用下面三个 LLM_* 配置，key 与 endpoint 必须配套。
# 使用百炼时也需要填写 LLM_API_KEY；仅填写 DASHSCOPE_API_KEY 不会配置 DSH。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Claude Agent SDK-compatible endpoint on Bailian. This is consumed only when
# CLAUDE_PROVIDER=dashscope.
DASHSCOPE_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
OPENAI_PROXY_API_KEY=
OPENAI_PROXY_BASE_URL=http://api.openai-proxy.com/v1/
NEXT_API_KEY=
NEXT_API_BASE_URL=https://api.nextapi.fun/v1/

# Databases
PLATFORM_DB_URL=
BUSINESS_DB_URL=
SYSTEM_DB_URL=
# Current deployment explicitly uses stock_agent with its existing account.
# SYSTEM_DB_URL=mysql+pymysql://USER:URL_ENCODED_PASSWORD@47.94.1.2:3312/stock_agent?charset=utf8mb4
# Switch only after migration passes. No implicit fallback to business URLs.
# Preferred shared business-data connection. When set, this takes precedence
# over BUSINESS_DB_URL for StockInfoDbUtils(database="kingdomai"). Host/port
# overrides can reuse credentials from the URL without duplicating secrets.
KINGDOMAI_DB_URL=
KINGDOMAI_DB_HOST=
KINGDOMAI_DB_PORT=
KINGDOMAI_DB_USER=
# Optional local-only credential reuse, e.g. PLATFORM_DB_URL, when that account
# is authorized on the kingdomai schema. Production should set KINGDOMAI_DB_URL.
KINGDOMAI_DB_CREDENTIAL_SOURCE=
REPORT_DB_URL=
KINGDOMAI_DB_PASSWORD=
STOCK_AGENT_DB_PASSWORD=

# Web
FIN_AGENT_PORT=22053
FIN_AGENT_FLASK_RELOADER=0
# Comma-separated public frontend origins allowed to call authenticated JSON APIs.
# Development example: http://127.0.0.1:22054,http://localhost:22054
FIN_AGENT_ALLOWED_ORIGINS=
# Leave empty to follow the request scheme. Set to 1 behind production HTTPS.
FIN_AGENT_COOKIE_SECURE=
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
FIN_AGENT_TRUST_PROXY_HEADERS=0

# Phone account registration. Production uses Aliyun PNVS; there is no mock fallback.
FIN_AGENT_PHONE_CHALLENGE_PROVIDER=aliyun_pnvs
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIN_AGENT_PHONE_CHALLENGE_SECRET=<generate-a-random-secret-at-least-32-bytes>
FIN_AGENT_PHONE_CHALLENGE_MOCK_ENABLED=0
FIN_AGENT_PHONE_CHALLENGE_MOCK_CODE=123456
FIN_AGENT_PHONE_CHALLENGE_TTL_SECONDS=600
FIN_AGENT_PHONE_CHALLENGE_RESEND_SECONDS=60
FIN_AGENT_PHONE_CHALLENGE_MAX_ATTEMPTS=5
FIN_AGENT_PHONE_CHALLENGE_RATE_WINDOW_SECONDS=3600
FIN_AGENT_PHONE_CHALLENGE_MOBILE_RATE_LIMIT=5
FIN_AGENT_PHONE_CHALLENGE_IP_RATE_LIMIT=20
FIN_AGENT_PHONE_CHALLENGE_GLOBAL_HOURLY_LIMIT=500
FIN_AGENT_PHONE_CHALLENGE_GLOBAL_DAILY_LIMIT=2000
# Recommended production provider: Aliyun Phone Number Verification Service.
FIN_AGENT_PNVS_SIGN_NAME=<aliyun-pnvs-approved-sign-name>
FIN_AGENT_PNVS_TEMPLATE_CODE=100001
FIN_AGENT_PNVS_SCHEME_NAME=fin-agent-register
FIN_AGENT_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
# Legacy alternative: ordinary Aliyun SMS with an approved custom template.
FIN_AGENT_SMS_ALIYUN_ACCESS_KEY_ID=<aliyun-access-key-id>
FIN_AGENT_SMS_ALIYUN_ACCESS_KEY_SECRET=<aliyun-access-key-secret>
FIN_AGENT_SMS_ALIYUN_SIGN_NAME=
FIN_AGENT_SMS_ALIYUN_TEMPLATE_CODE=
FIN_AGENT_SMS_ALIYUN_TEMPLATE_PARAM_KEY=code
FIN_AGENT_SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
FIN_AGENT_SMS_ALIYUN_REGION_ID=cn-hangzhou
FIN_AGENT_SMS_CONNECT_TIMEOUT_MS=3000
FIN_AGENT_SMS_READ_TIMEOUT_MS=5000

# Shared authentication limiter. May intentionally share the challenge secret,
# but a separate secret makes rotation independent.
FIN_AGENT_AUTH_RATE_SECRET=<generate-a-second-random-secret-at-least-32-bytes>
FIN_AGENT_AUTH_LOGIN_MOBILE_LIMIT=8
FIN_AGENT_AUTH_LOGIN_IP_LIMIT=30
FIN_AGENT_AUTH_LOGIN_WINDOW_SECONDS=600
# All-attempt budgets include successful logins, protecting PBKDF2/session CPU.
FIN_AGENT_AUTH_REQUEST_IP_LIMIT=20
FIN_AGENT_AUTH_REQUEST_GLOBAL_LIMIT=120
FIN_AGENT_AUTH_REQUEST_WINDOW_SECONDS=60

# Optional second layer: carrier real-name/mobile match. Mobile2MetaVerify does
# not prove phone possession and is never used as a replacement for SMS OTP.
FIN_AGENT_PHONE_IDENTITY_MATCH_REQUIRED=0
FIN_AGENT_PHONE_VERIFY_PROVIDER=disabled
FIN_AGENT_PHONE_VERIFY_MOCK_ENABLED=0
FIN_AGENT_PHONE_VERIFY_ALIYUN_ACCESS_KEY_ID=
FIN_AGENT_PHONE_VERIFY_ALIYUN_ACCESS_KEY_SECRET=
FIN_AGENT_PHONE_VERIFY_ALIYUN_ENDPOINT=cloudauth.aliyuncs.com
FIN_AGENT_PHONE_VERIFY_ALIYUN_REGION_ID=cn-beijing
FIN_AGENT_PHONE_VERIFY_CONNECT_TIMEOUT_MS=3000
FIN_AGENT_PHONE_VERIFY_READ_TIMEOUT_MS=5000

# Codex custom-tool runtime (idle / hard timeout, seconds)
STOCK_AGENT_CUSTOM_TOOL_CODEX_TIMEOUT_SECONDS=300
STOCK_AGENT_CUSTOM_TOOL_CODEX_HARD_TIMEOUT_SECONDS=1800
# Codex authentication priority:
# 1) explicit STOCK_AGENT_CODEX_AUTH_MODE; 2) in auto mode, a non-empty
# CODEX_CRS_API_KEY selects CRS; 3) otherwise reuse the local ChatGPT subscription.
# Values: auto | subscription | crs_api_key | api_key | access_token
STOCK_AGENT_CODEX_AUTH_MODE=auto
CODEX_CRS_API_KEY=
CODEX_CRS_BASE_URL=https://proxy.kingdomai.com/openai
CODEX_CRS_MODEL=gpt-6-astra
CODEX_CRS_REASONING_EFFORT=low
STOCK_AGENT_CUSTOM_TOOL_CODEX_MODEL=gpt-6-astra
STOCK_AGENT_CUSTOM_TOOL_CODEX_REASONING=low
# Astra requires Codex CLI >=0.153.1; point to an independently installed runtime.
# STOCK_AGENT_CODEX_BIN=/absolute/path/to/codex
STOCK_AGENT_CUSTOM_TOOL_DIRECT_TIMEOUT_SECONDS=180
STOCK_AGENT_CUSTOM_TOOL_DIRECT_HARD_TIMEOUT_SECONDS=600

# Provider choices stay in the system adapter, outside the business protocol.
CUSTOM_TOOL_AGENT_ENABLED=1
# Main custom-tool orchestration: DSH Opt for requirement/design/flow/direct;
# Codex for implementation, focused edit planning and test-case planning.
CUSTOM_TOOL_ORCHESTRATOR=dsh_opt
CUSTOM_TOOL_DESIGN_PROVIDER=codex
CUSTOM_TOOL_DESIGN_COMPLEXITY=fast
CUSTOM_TOOL_CODING_PROVIDER=codex
CUSTOM_TOOL_CODING_COMPLEXITY=mid
# Edit 先用轻量语义规划定位修改范围；明确局部修改使用较快 Coding 档。
CUSTOM_TOOL_EDIT_PLAN_COMPLEXITY=fastest
CUSTOM_TOOL_EDIT_CODING_COMPLEXITY=fastest
# 测试 Skill 审阅真实结果并决定是否继续；系统以此限制最多规划/复核轮次。
CUSTOM_TOOL_TEST_MAX_TURNS=4
# 只控制互不依赖的计划步骤和旧版多调用资产；列表原生工具始终单次调用。
FIN_AGENT_TOOL_PARALLELISM=8
# 行情/成分查询的硬安全上限。limit=-1 表示业务上显式全量；若实际结果
# 超过这里的保护值会明确报错，可在已授权的大批量任务中调高，不会静默截断。
FIN_AGENT_QUOTE_HARD_ROW_LIMIT=500000
# 三个月预查：不设置时仅对企业多源查询的时间 Top-N 默认启用；
# 股票/基金/债券/指数/板块行情均直接按代码和日期有界读取，无需额外预查。
# 0 全部关闭，1 对其他满足正确性条件的查询也强制启用（仅建议用于 A/B）。
# 不改变用户时间范围；近期不足时工具内部最多补查一次原范围。
# FIN_AGENT_RECENT_SCAN_ENABLED=0
FIN_AGENT_INTRADAY_HARD_ROW_LIMIT=500000
FIN_AGENT_LATEST_QUOTE_HARD_LIMIT=10000
FIN_AGENT_CONSTITUTION_HARD_ROW_LIMIT=10000
# Research report/report_metric rows; limit=-1 fails explicitly above this cap.
FIN_AGENT_REPORT_HARD_ROW_LIMIT=100000
# 当前主链路禁用 Web Search 与 MCP。
CUSTOM_TOOL_AGENT_WEB_SEARCH=disabled
# 保持为空即不向 Agent 暴露任何 MCP server。
# Credentials must be referenced by environment-variable name inside the JSON file.
CUSTOM_TOOL_AGENT_MCP_CONFIG_PATH=

# Provider-neutral evidence search. The Agent/Skill contract stays as
# general_search; switch providers here without changing prompts or tools.
# Current implementation: elasticsearch. Future providers can implement the
# same gateway contract (for example Google Search API).
FIN_AGENT_SEARCH_PROVIDER=elasticsearch
FIN_AGENT_SEARCH_COVERAGE=internal_news
FIN_AGENT_SEARCH_ES_URL=http://127.0.0.1:9200
FIN_AGENT_SEARCH_ES_INDEX=personal_news_articles
FIN_AGENT_SEARCH_ES_TIMEOUT_SECONDS=8
# personal_news: flat published_at/source_id fields; public_opinion:
# article_news_* with pub_time and nested related_cp_score.code.
FIN_AGENT_SEARCH_ES_PROFILE=personal_news
# Inject credentials through the deployment secret store. Never commit values.
FIN_AGENT_SEARCH_ES_USERNAME=
FIN_AGENT_SEARCH_ES_PASSWORD=

# Claude Agent SDK over Bailian's Anthropic-compatible endpoint.
CLAUDE_PROVIDER=dashscope
CLAUDE_MODEL=
# dashscope uses DASHSCOPE_ANTHROPIC_BASE_URL (including regional overrides).
# CLAUDE_BASE_URL is reserved for anthropic/gateway providers.
CLAUDE_BASE_URL=
ANTHROPIC_API_KEY=
CLAUDE_AUTH_TOKEN=
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_TIMEOUT_SECONDS=300
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_HARD_TIMEOUT_SECONDS=1800
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_MAX_TURNS=20
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_MAX_BUDGET_USD=0
STOCK_AGENT_CUSTOM_TOOL_CLAUDE_EFFORT=high

# Finance CC shadow session. It observes Finance turns but does not change routing, replies, or DB state.
FINANCE_CC_SHADOW_ENABLED=0
FINANCE_CC_PROVIDER=deepseek
FINANCE_CC_MODEL=deepseek-v4-flash-0731
FINANCE_CC_EFFORT=low
FINANCE_CC_MAX_TURNS=20
FINANCE_CC_WARM_POOL_SIZE=2
FINANCE_CC_WARM_POOL_TIMEOUT_SECONDS=30
FINANCE_CC_MAX_LIVE_CLIENTS=8
FINANCE_CC_CLIENT_IDLE_SECONDS=300
FINANCE_CC_HTTPS_BRIDGE_ENABLED=1
FINANCE_CC_BRIDGE_READ_IDLE_SECONDS=120
FINANCE_CC_API_MAX_RETRIES=2
FINANCE_CC_FIRST_RESPONSE_TIMEOUT_SECONDS=45
FINANCE_CC_TURN_TIMEOUT_SECONDS=180
# 已发布 Skill 声明 execution-budget: long 时使用，普通问答仍使用上方预算。
FINANCE_CC_LONG_TURN_TIMEOUT_SECONDS=900
# Legacy rollback only: set CUSTOM_TOOL_ORCHESTRATOR=cc to restore this path.
FINANCE_CC_TOOL_DEVELOPMENT_ENABLED=0
FINANCE_CC_FINANCIAL_QA_ENABLED=0
FINANCE_CC_FINANCIAL_QA_MAX_TURNS=12
FINANCE_CC_FINANCIAL_QA_EFFORT=low

# Optional DeepSeek Harness execution path for financial data queries. Web chat
# uses this configurable default when a request does not explicitly select cc/dsh.
FINANCE_CHAT_DEFAULT_RUNTIME=cc
FINANCE_DSH_FINANCIAL_QA_ENABLED=0
FINANCE_DSH_PROVIDER=deepseek-official
# The provider value names the Harness adapter, not the upstream vendor.
# DSH reads LLM_API_KEY / LLM_BASE_URL / LLM_DEFAULT_MODEL above directly.
# Financial data queries default to low; the upstream adapter default is high.
FINANCE_DSH_REASONING_EFFORT=low
# 8C/16GB single-instance profile: one reusable Harness worker per admitted
# request. Workers are lazy-started, so idle slots do not spawn child processes.
FINANCE_DSH_WORKERS=10
FINANCE_DSH_MAX_TOKENS=8192
FINANCE_DSH_TURN_TIMEOUT_SECONDS=300
# Maximum time waiting for an available Harness worker. Keep this no greater
# than the caller/proxy timeout so overload fails visibly instead of hanging.
FINANCE_DSH_QUEUE_TIMEOUT_SECONDS=300
# Warm all 10 Harness/MCP workers concurrently when the standalone API starts.
FINANCE_DSH_PREWARM_ON_START=1
FINANCE_DSH_PREWARM_WORKERS=10
# DSH Opt custom-tool controller. It has an isolated worker pool and policy;
# saved flow assets return to the parent process for Codex implementation.
FINANCE_DSH_CUSTOM_TOOL_ENABLED=1
FINANCE_DSH_CUSTOM_TOOL_WORKERS=2
FINANCE_DSH_CUSTOM_TOOL_MODEL=deepseek-v4-flash
# Custom-tool DSH is fail-closed to DashScope and reads DASHSCOPE_API_KEY.
# Optional regional DashScope endpoint override; DeepSeek official URLs are rejected.
# FINANCE_DSH_CUSTOM_TOOL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCE_DSH_CUSTOM_TOOL_MAX_TOKENS=8192
FINANCE_DSH_CUSTOM_TOOL_TURN_TIMEOUT_SECONDS=300
FINANCE_DSH_CUSTOM_TOOL_QUEUE_TIMEOUT_SECONDS=300
# Natural-language entry routing also uses a small DSH worker pool. Custom-tool
# turns bypass the legacy direct-LLM conversation preprocessor after this route.
FINANCE_DSH_CUSTOM_TOOL_INTENT_ENABLED=1
FINANCE_DSH_CUSTOM_TOOL_INTENT_WORKERS=2
FINANCE_DSH_CUSTOM_TOOL_INTENT_MAX_TOKENS=768
FINANCE_DSH_CUSTOM_TOOL_INTENT_TIMEOUT_SECONDS=90
# Current defaults; businessHint and stage budgets can be tuned/evaluated
# without changing the artifact, ownership or execution protocols.
# FINANCE_DSH_CUSTOM_TOOL_POLICY_CONFIG={"enabled":true,"duplicateCallLimit":1,"maxRequiredStageSteers":1,"businessHint":"","budgets":{"requirement":{"reasoningEffort":"low","maxTokens":4096},"design":{"reasoningEffort":"low","maxTokens":6144},"flow":{"reasoningEffort":"off","maxTokens":3072},"direct":{"reasoningEffort":"low","maxTokens":3072},"final":{"reasoningEffort":"off","maxTokens":2048}}}
# DSH-only bounded loop policy. The JSON can override retry ceilings,
# duplicateCallLimit, businessHint, and per-stage reasoningEffort/maxTokens.
# Stable-prefix mode keeps tool schemas fixed; stage prompts and request budgets
# are still injected per request through Harness lifecycle events.
# Current DSH opt defaults (omitting the variable is equivalent):
# FINANCE_DSH_LOOP_POLICY_CONFIG={"enabled":true,"preserveRequestPrefix":true,"maxCatalogAttempts":6,"maxQueryAttempts":3,"maxQueryRepairs":1,"maxLoadAttempts":2,"duplicateCallLimit":1,"maxRequiredStageSteers":1,"businessHint":"","budgets":{"catalog":{"reasoningEffort":"low","maxTokens":1536},"query":{"reasoningEffort":"low","maxTokens":3072},"repair":{"reasoningEffort":"low","maxTokens":3072},"details":{"reasoningEffort":"off","maxTokens":2048},"final":{"reasoningEffort":"off","maxTokens":2048}}}
# Reproducible DSH low baseline (no DSH-specific orchestration):
# FINANCE_DSH_LOOP_POLICY_CONFIG={"enabled":false}
# Production: installed dsh executable and Python SDK. Repository-local
# development may point to the adjacent deepseek-harness checkout instead.
# FINANCE_DSH_BIN=/absolute/path/to/dsh
# FINANCE_DSH_SDK_SOURCE=/absolute/path/to/deepseek-harness/python/sdk/src
# FINANCE_DSH_SOURCE_ROOT=/absolute/path/to/deepseek-harness
# FINANCE_DSH_NODE_BIN=/absolute/path/to/node

# Independent financial data HTTP + MCP service. Actual query endpoints fail
# closed unless at least one key is configured. Prefer named keys so logs and
# future quotas can identify callers without recording the secret itself.
FINANCE_API_HOST=0.0.0.0
FINANCE_API_PORT=22100
# External path prefix when a reverse proxy strips it before forwarding.
# FINANCE_API_ROOT_PATH=/finance
FINANCE_API_DEFAULT_RUNTIME=dsh
FINANCE_API_MAX_CONCURRENCY=10
# Single-client form:
# FINANCE_API_KEY_ID=internal
# FINANCE_API_KEY=replace-with-at-least-24-random-characters
# Multi-client form takes precedence over FINANCE_API_KEY:
# FINANCE_API_KEYS_JSON='{"internal":"replace-with-at-least-24-random-characters","partner-a":"replace-with-another-random-key"}'
# MCP DNS-rebinding protection. Add the production domain and optional port.
FINANCE_API_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# Browser Origin allowlist for MCP requests, if a browser-hosted client is used.
FINANCE_API_ALLOWED_ORIGINS=
# Optional REST browser clients; leave empty for server-to-server use.
FINANCE_API_CORS_ORIGINS=
FINANCE_API_LOG_LEVEL=info

# Cached data status page at /status (Asia/Shanghai).
FINANCE_STATUS_ENABLED=1
FINANCE_STATUS_CHECK_TIME=15:30
FINANCE_STATUS_INTERVAL_SECONDS=900
FINANCE_STATUS_REALTIME_INTERVAL_SECONDS=60
FINANCE_STATUS_REALTIME_TOLERANCE_SECONDS=300
FINANCE_STATUS_SNAPSHOT_PATH=data/finance_status/latest.json
# FINANCE_STATUS_LAGS_JSON='{"stock.quote":0}'

DASHSCOPE_ANTHROPIC_CA_BUNDLE=
# 可选：PDF 导出所用的可嵌入中文 TTF/TTC 字体。macOS 和常见 Linux Noto 字体会自动发现。
# FIN_AGENT_PDF_FONT_PATH=/path/to/NotoSansCJK-Regular.ttc

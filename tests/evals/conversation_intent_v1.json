{
  "eval_name": "conversation_intent_v1",
  "protocol_version": "v1",
  "application_name": "investment_workbench",
  "description": "真实串联上下文语义补全与顶层 agent_name + turn_mode 路由。",
  "cases": [
    {
      "case_id": "finance_standalone_quote",
      "category": "happy_path",
      "input": "宁德时代现在股价是多少？",
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "normal_qa",
        "resolved_contains_all": ["宁德时代"],
        "max_context_refs": 0,
        "llm_policy": "required"
      }
    },
    {
      "case_id": "finance_pronoun_followup",
      "category": "context_resolution",
      "input": "那五粮液呢？",
      "thread_context": {
        "context_window": [
          {"round": 1, "role": "user", "text": "贵州茅台今天的开盘价是多少？"},
          {"round": 1, "role": "assistant", "text": "已查询贵州茅台今天的开盘价。"}
        ]
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "normal_qa",
        "resolved_contains_all": ["五粮液"],
        "resolved_contains_any_groups": [["开盘价", "开盘价格"]],
        "context_ref_prefixes": ["turn:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "unrelated_question_does_not_inherit_finance",
      "category": "boundary",
      "input": "帮我写一句生日祝福",
      "thread_context": {
        "context_window": [
          {"round": 1, "role": "user", "text": "贵州茅台今天的开盘价是多少？"},
          {"round": 1, "role": "assistant", "text": "已查询贵州茅台今天的开盘价。"}
        ]
      },
      "expected": {
        "agent_name": "default_assistant",
        "turn_mode": "normal_qa",
        "resolved_contains_all": ["生日祝福"],
        "max_context_refs": 0,
        "llm_policy": "required"
      }
    },
    {
      "case_id": "natural_language_system_tool_call",
      "category": "system_operation",
      "input": "运行一下stock_realtime_quote工具查询宁德时代",
      "expected": {
        "agent_name": "default_assistant",
        "turn_mode": "system_operation",
        "resolved_contains_all": ["stock_realtime_quote", "宁德时代"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "slash_tools_catalog",
      "category": "rule_path",
      "input": "/tools",
      "expected": {
        "agent_name": "default_assistant",
        "turn_mode": "system_operation",
        "llm_policy": "forbidden"
      }
    },
    {
      "case_id": "slash_custom_tool_create",
      "category": "rule_path",
      "input": "/custom_tool create 创建一个判断最近30或60个交易日是否出现金叉的工具",
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",
        "llm_policy": "forbidden"
      }
    },
    {
      "case_id": "slash_custom_tool_edit",
      "category": "rule_path",
      "input": "/custom_tool edit 把短期均线改为10日",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation"
        }
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",
        "llm_policy": "forbidden"
      }
    },
    {
      "case_id": "slash_custom_tool_call",
      "category": "rule_path",
      "input": "/custom_tool call golden_cross_30_60 {\"stock_code\":\"300750\"}",
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "system_operation",
        "llm_policy": "forbidden"
      }
    },
    {
      "case_id": "active_tool_view_code",
      "category": "tool_context",
      "input": "给我看看这个工具的核心代码",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation",
          "design_contract": {"display_name": "30/60日金叉判断"}
        }
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",
        "resolved_contains_all": ["核心代码"],
        "context_ref_prefixes": ["custom_tool:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "active_tool_modify_threshold",
      "category": "tool_context",
      "input": "把当前工具的阈值提高到5%",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation",
          "design_contract": {"display_name": "30/60日金叉判断"}
        }
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",
        "resolved_contains_all": ["5%"],
        "context_ref_prefixes": ["custom_tool:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "active_tool_switch_to_finance_question",
      "category": "boundary",
      "input": "宁德时代现在股价是多少？",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation"
        }
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "normal_qa",
        "resolved_contains_all": ["宁德时代"],
        "max_context_refs": 0,
        "llm_policy": "required"
      }
    },
    {
      "case_id": "system_slash_followup_open_second",
      "category": "context_resolution",
      "input": "打开第二个",
      "thread_context": {
        "context_window": [
          {"round": 1, "role": "user", "text": "/tools"},
          {"round": 1, "role": "assistant", "text": "工具列表：1. stock_realtime_quote；2. stock_history_kline。"}
        ]
      },
      "expected": {
        "agent_name": "default_assistant",
        "turn_mode": "system_operation",
        "resolved_contains_all": ["stock_history_kline"],
        "context_ref_prefixes": ["turn:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "natural_language_tool_create_is_gated",
      "category": "boundary",
      "input": "帮我创建一个金叉判断工具",
      "expected": {
        "forbidden_turn_modes": ["tool_development"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "attachment_summary_by_reference",
      "category": "large_context",
      "input": "总结这个文件",
      "attachments": [
        {
          "attachment_id": "report_1024",
          "kind": "document",
          "mime_type": "application/pdf",
          "file_name": "新能源汽车行业深度研报.pdf",
          "file_size": 104857600
        }
      ],
      "expected": {
        "agent_name_in": ["default_assistant", "investment_analyst"],
        "turn_mode": "normal_qa",
        "resolved_contains_any_groups": [["新能源汽车行业深度研报", "这个文件"]],
        "context_ref_prefixes": ["attachment:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "continue_without_context",
      "category": "missing_evidence",
      "input": "继续",
      "expected": {
        "agent_name": "default_assistant",
        "turn_mode": "normal_qa",
        "max_context_refs": 0,
        "llm_policy": "required"
      }
    }
  ]
}

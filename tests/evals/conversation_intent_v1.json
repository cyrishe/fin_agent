    {
      "case_id": "return_to_active_tool_after_finance_question",
      "category": "context_resolution",
      "input": "回到刚才的工具，把输入改成单只股票",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation",
          "design_contract": {"display_name": "30/60日金叉判断"}
        },
        "context_window": [
          {"round": 1, "role": "user", "text": "/custom_tool create 判断最近30或60个交易日是否出现金叉"},
          {"round": 1, "role": "assistant", "text": "已经形成30/60日…"},
          {"round": 2, "role": "user", "text": "今天茅台的收盘价是多少？"},
          {"round": 2, "role": "assistant", "text": "已返回贵州茅台今天的…"}
        ]
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",

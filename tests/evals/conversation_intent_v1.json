        "llm_policy": "required"
      }
    },
    {
      "case_id": "active_tool_switch_to_finance_question",
      "category": "boundary",
      "input": "宁德时代现在股价是多少？",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation"
        }
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "normal_qa",
        "resolved_contains_all": ["宁德时代"],
        "max_context_refs": 0,
        "llm_policy": "required"
      }
    },
    {
      "case_id": "active_tool_switch_to_maotai_close",
      "category": "boundary",
      "input": "今天茅台的收盘价是多少？",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation",
          "design_contract": {"display_name": "30/60日金叉判断"}
        },
        "context_window": [
          {"round": 1, "role": "user", "text": "/custom_tool create 判断最近30或60个交易日是否出现金叉"},
          {"round": 1, "role": "assistant", "text": "已经形成30/60日…"}

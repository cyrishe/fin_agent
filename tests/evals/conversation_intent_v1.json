        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation",
          "design_contract": {"display_name": "30/60日金叉判断"}
        }
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",
        "resolved_contains_all": ["核心代码"],
        "context_ref_prefixes": ["custom_tool:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "active_tool_modify_threshold",
      "category": "tool_context",
      "input": "把当前工具的阈值提高到5%",
      "thread_context": {
        "custom_tool_state": {
          "tool_name": "golden_cross_30_60",
          "status": "awaiting_design_confirmation",
          "design_contract": {"display_name": "30/60日金叉判断"}
        }
      },
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",

        "llm_policy": "required"
      }
    },
    {
      "case_id": "system_slash_followup_open_second",
      "category": "context_resolution",
      "input": "打开第二个",
      "thread_context": {
        "context_window": [
          {"round": 1, "role": "user", "text": "/tools"},
          {"round": 1, "role": "assistant", "text": "工具列表：1. st…"}
        ]
      },
      "expected": {
        "agent_name_in": ["default_assistant", "investment_analyst"],
        "turn_mode": "system_operation",
        "resolved_contains_all": ["第二"],
        "context_ref_prefixes": ["turn:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "natural_language_tool_create",
      "category": "happy_path",
      "input": "帮我创建一个选股工具，逻辑是最近20个交易日涨幅超过10%，且成交量放大。",
      "expected": {
        "agent_name": "investment_analyst",
        "turn_mode": "tool_development",
        "resolved_contains_all": ["选股工具"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "attachment_summary_by_reference",
      "category": "large_context",
      "input": "总结这个文件",
      "attachments": [
        {
          "attachment_id": "report_1024",
          "kind": "document",
          "mime_type": "application/pdf",
          "file_name": "新能源汽车行业深度研报.pdf",
          "file_size": 104857600
        }
      ],
      "expected": {
        "agent_name_in": ["default_assistant", "investment_analyst"],
        "turn_mode": "normal_qa",
        "resolved_contains_any_groups": [["新能源汽车行业深度研报", "这个文件"]],
        "context_ref_prefixes": ["attachment:"],
        "llm_policy": "required"
      }
    },
    {
      "case_id": "continue_without_context",
      "category": "missing_evidence",
      "input": "继续",
      "expected": {
        "agent_name": "default_assistant",
        "turn_mode": "normal_qa",
        "max_context_refs": 0,
        "llm_policy": "required"
      }
    }
  ]
}

[
  {
    "case_id": "market_amount_10d_by_market",
    "suite": "tool_selection_and_arguments",
    "priority": "P0",
    "title": "市场总成交额近 10 日走势",
    "input": {
      "messages": [
        {
          "role": "user",
          "content": "最近 10 个交易日，上证、深证、北证三大市场的总成交额分别是什么走势？帮我按日期列出来。"
        }
      ],
      "context": {},
      "attachments": []
    },
    "checks": [
      {
        "stage": "dialogue_understanding",
        "assert": {
          "needs_reference_resolution": false
        }
      },
      {
        "stage": "task_normalization",
        "assert": {
          "must_include": ["市场", "最近10个交易日", "总成交额"],
          "must_not_include": ["个股", "K线", "指数历史行情"]
        }
      },
      {
        "stage": "tool_selection",
        "assert": {
          "must_include_tools": ["market_history_amount"],
          "must_not_include_tools": ["stock_history_kline", "stock_history_funds_flow"]
        }
      },
      {
        "stage": "plan_compile",
        "assert": {
          "tool_arguments": {
            "market_history_amount": {
              "days": 10
            }
          }
        }
      }
    ],
    "tags": ["market", "amount", "tool_selection", "arguments"]
  },
  {
    "case_id": "second_item_followup_funds",
    "suite": "conversation_continuity",
    "priority": "P0",
    "title": "第二个对象续问资金面",
    "input": {
      "messages": [
        {
          "role": "user",
          "content": "比较一下公司A和公司B今天的行情。"
        },
        {
          "role": "assistant",
          "content": "已比较公司A和公司B，公司A为第一个对象，公司B为第二个对象。"
        },
        {
          "role": "user",
          "content": "第二个公司的资金面也看一下。"
        }
      ],
      "context": {
        "referents": [
          {"label": "公司A", "type": "company", "ordinal": 1},
          {"label": "公司B", "type": "company", "ordinal": 2}
        ]
      },
      "attachments": []
    },
    "checks": [
      {
        "stage": "dialogue_understanding",
        "assert": {
          "needs_reference_resolution": true
        }
      },
      {
        "stage": "reference_resolution",
        "assert": {
          "resolved_label": "公司B"
        }
      },
      {
        "stage": "tool_selection",
        "assert": {
          "must_include_any_tool_group": [["stock_realtime_funds_flow", "stock_history_funds_flow"]]
        }
      },
      {
        "stage": "plan_compile",
        "assert": {
          "tool_arguments_any": {
            "stock_realtime_funds_flow": {"name": "公司B"},
            "stock_history_funds_flow": {"name": "公司B"}
          }
        }
      }
    ],
    "tags": ["continuity", "reference", "funds"]
  },

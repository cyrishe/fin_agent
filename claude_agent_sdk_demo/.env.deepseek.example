# Direct Claude Code / Agent SDK -> official DeepSeek Anthropic API.
CLAUDE_DEMO_BACKEND=claude
CLAUDE_PROVIDER=deepseek
CLAUDE_MODEL=deepseek-v4-flash
CLAUDE_BASE_URL=https://api.deepseek.com/anthropic
CLAUDE_EFFORT=max

# Keep the real value in the untracked .env.deepseek file.
DEEPSEEK_API_KEY=replace-me

# DeepSeek documents Anthropic web-search result block compatibility. The
# optional --with-web-search probe verifies this against your account/runtime.
WEB_SEARCH_BACKEND=builtin

CLAUDE_MAX_TURNS=8
CLAUDE_MAX_BUDGET_USD=1.0
CLAUDE_HARD_TIMEOUT_SECONDS=300
CLAUDE_IDLE_TIMEOUT_SECONDS=90
SSE_HEARTBEAT_SECONDS=15
MAX_CONCURRENT_RUNS=2
DEMO_ALLOW_SESSION_RESUME=false

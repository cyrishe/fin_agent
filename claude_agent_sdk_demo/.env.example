# Offline verification. No model calls or credentials required.
CLAUDE_DEMO_BACKEND=fake

# Real Claude Agent SDK mode.
# CLAUDE_DEMO_BACKEND=claude
# CLAUDE_PROVIDER=anthropic
# CLAUDE_MODEL=sonnet
# CLAUDE_API_KEY=replace-me

# Anthropic-compatible MaaS / LLM gateway mode.
# The endpoint must implement Anthropic Messages streaming semantics.
# CLAUDE_PROVIDER=gateway
# CLAUDE_BASE_URL=https://maas.example.com
# CLAUDE_AUTH_TOKEN=replace-me
# CLAUDE_MODEL=your-model-id

# DeepSeek V4 Flash has a dedicated ready-to-copy profile in
# .env.deepseek.example. Use provider=deepseek only with the official endpoint;
# use provider=gateway for a third-party MaaS hosting DeepSeek weights.

# Web search: builtin | searxng | disabled
WEB_SEARCH_BACKEND=builtin
# SEARXNG_BASE_URL=http://127.0.0.1:8080

CLAUDE_MAX_TURNS=8
CLAUDE_MAX_BUDGET_USD=1.0
CLAUDE_HARD_TIMEOUT_SECONDS=300
CLAUDE_IDLE_TIMEOUT_SECONDS=90
SSE_HEARTBEAT_SECONDS=15
MAX_CONCURRENT_RUNS=4

# Resume must remain off until the host maps each session ID to an authenticated owner.
DEMO_ALLOW_SESSION_RESUME=false

# Optional protection for the demo HTTP endpoint.
# DEMO_CLIENT_API_KEY=replace-me

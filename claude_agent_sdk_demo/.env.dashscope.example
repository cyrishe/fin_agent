# Claude Agent SDK -> Alibaba Cloud Model Studio pay-as-you-go Anthropic API.
CLAUDE_DEMO_BACKEND=claude
CLAUDE_PROVIDER=dashscope
CLAUDE_MODEL=deepseek-v4-flash
CLAUDE_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# Prefer DASHSCOPE_API_KEY for a standalone config. This demo also accepts the
# main project's LLM_KEY when ../.env has been loaded into the environment.
DASHSCOPE_API_KEY=replace-me

WEB_SEARCH_BACKEND=builtin
CLAUDE_MAX_TURNS=8
CLAUDE_MAX_BUDGET_USD=1.0
CLAUDE_HARD_TIMEOUT_SECONDS=300
CLAUDE_IDLE_TIMEOUT_SECONDS=90
SSE_HEARTBEAT_SECONDS=15
MAX_CONCURRENT_RUNS=2
DEMO_ALLOW_SESSION_RESUME=false
